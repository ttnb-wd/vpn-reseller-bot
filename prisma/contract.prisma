model Customer {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  username   String?
  firstName  String?
  createdAt  DateTime @default(now())

  orders       Order[]
  subscription Subscription?
  supportTickets SupportTicket[]
  supportMessages SupportMessage[]
}

model SupportTicket {
  id                   Int      @id @default(autoincrement())
  customerId           Int
  customer             Customer @relation(fields: [customerId], references: [id])
  status               String   @default("OPEN")
  customerInputActive  Boolean  @default(true)
  adminReplySelected   Boolean  @default(false)
  adminReplySelectedAt DateTime?
  acknowledgedAt       DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now())
  closedAt             DateTime?
  messages             SupportMessage[]
}

model SupportMessage {
  id         Int @id @default(autoincrement())
  ticketId   Int
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  sender     String
  text       String
  createdAt  DateTime @default(now())
}

model Package {
  id           Int      @id @default(autoincrement())
  name         String
  dataLimitGb  Float
  durationDays Int
  priceMmk     Decimal

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  orders       Order[]
  subscriptions Subscription[]
}

model Order {
  id          Int      @id @default(autoincrement())
  orderNumber String   @unique

  plan      String
  packageId Int?
  package   Package? @relation(fields: [packageId], references: [id])

  durationMonths Int @default(1)
  totalDurationDays Int?

  totalDataGb Float?
  price       Decimal

  status       String
  createdAt    DateTime  @default(now())
  processingAt DateTime?

  paymentMethod    String?
  paymentReference String?
  paymentProof     String?
  paidAt           DateTime?

  vpnKey          String?
  vpnKeyId        String?
  vpnKeyCreatedAt DateTime?

  startedAt DateTime?
  expiresAt DateTime?
  revokedAt DateTime?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Subscription {
  id Int @id @default(autoincrement())

  customerId Int      @unique
  customer   Customer @relation(fields: [customerId], references: [id])

  packageId Int?
  package   Package? @relation(fields: [packageId], references: [id])

  plan           String
  status         String
  durationMonths Int @default(1)

  vpnKey          String?
  vpnKeyId        String?
  vpnKeyCreatedAt DateTime?

  startedAt DateTime?
  expiresAt DateTime?
  revokedAt DateTime?

  dataLimitGb Float?
  dataUsedGb  Float @default(0)
  lastUsageSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}
