[Unit]
Description=Recover an interrupted Metro VPN image deployment
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/libexec/metro-ci-deploy.py --recover
UMask=0077
TimeoutStartSec=600
Restart=on-failure
RestartSec=30
MemoryMax=128M
MemorySwapMax=0
TasksMax=64

[Install]
WantedBy=multi-user.target
