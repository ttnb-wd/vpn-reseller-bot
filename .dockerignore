# Allowlist: credentials, backups, tests, Git, tooling and local dependencies
# never enter the build context. Keep this aligned with Dockerfile COPY inputs.
**
!package.json
!package-lock.json
!src/
src/**
!src/*.js
!src/mini-app/
src/mini-app/**
!src/mini-app/index.html
!src/mini-app/app.js
!src/mini-app/app.css
!src/mini-app/metro-secure-icon.png
!prisma/
prisma/**
!prisma/contract.json
!assets/
assets/**
!assets/images/
assets/images/**
!assets/images/welcome-metro-secure.png
!assets/images/package-metro-secure.png
!deploy/
deploy/**
!deploy/healthcheck.cjs
src/test-*.js
src/verify-*.js
src/production-reset.js
src/reset-db-connection.js

# Directory exceptions above must not admit test fixtures or private artifacts.
src/*.cjs
**/*.test.*
**/.env
**/.env.*
**/*.env
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.ppk
**/id_rsa*
**/id_ed25519*
**/*.dpapi
**/*.metrobackup*
**/*.dump
**/*.backup
**/*.sql
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
**/__pycache__
**/*.py[cod]
